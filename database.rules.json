{
  "rules": {
    "presence": {
      "$deviceId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "liveStats": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.firebase.sign_in_provider == 'password' || auth.token.admin == true)"
    },
    "unlockState": {
      "$deviceId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "scheduledJobs": {
      ".indexOn": ["targetDeviceId", "status", "scheduledFor"],
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.firebase.sign_in_provider == 'password' || auth.token.admin == true)"
    }
  }
}
